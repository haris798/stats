# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the application
APP_URL="MY_APP_URL"

# Supabase Credentials for Stats.ku (ScreenTime.ku)
# NOTE: Use ONLY the anon key on client/APK. Never put service_role key here.
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
